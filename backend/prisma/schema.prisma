// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id   String @id @default(uuid())
  name String
  code String @unique

  email   String?
  phone   String?
  website String?
  address String?
  logo    String?

  gstNumber        String?
  subscriptionPlan String    @default("basic")
  subscriptionEnd  DateTime?
  maxBranches      Int       @default(1)
  maxEmployees     Int       @default(10)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  role        Role[]
  permission  Permission[]
  branches    Branch[]
  categories  Category[]
  attendances Attendance[]

  companySettings CompanySettings[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  isActive Boolean @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  createdBy     String? //  Kisne ne banaya
  createdByUser User?   @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[]  @relation("CreatedBy")

  // employee field add kro
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  //  Personal Info
  employeeCode  String?   @unique
  phone         String?
  dateOfBirth   DateTime?
  gender        String? // Male/Female/Other
  bloodGroup    String?
  maritalStatus String? // Single/Married
  profilePhoto  String?

  //  Address
  currentAddress   String?
  permanentAddress String?

  //  Employment Info
  designation        String?
  joiningDate        DateTime?
  employmentType     String? // Full-time/Part-time/Contract/Intern
  workShift          String? // Morning/Evening/Night
  reportingManagerId String?
  reportingManager   User?     @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  teamMembers        User[]    @relation("ReportingManager")

  //  Government IDs
  panNumber    String?
  aadharNumber String?

  //  Bank Details
  bankAccountNumber String?
  bankIFSC          String?
  bankName          String?

  //  Statutory
  pfNumber  String?
  esiNumber String?

  //  Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastLogin      DateTime?
  attendances    Attendance[]
  leaveRequests  LeaveRequest[] @relation("LeaveRequests")
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
}

//Roles Table — UI se banenge, hardcoded nahi
model Role {
  id           Int     @id @default(autoincrement())
  name         String //  "HR Manager" , "Accountant" , "Branch Manager"
  description  String?
  isActive     Boolean @default(true)
  isSystemRole Boolean @default(false)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  user        User[]
  permissions Permission[]

  @@unique([name, companyId])
}

//Modules Table — Kaunse modules hain system mein
model Module {
  id          Int     @id @default(autoincrement())
  name        String  @unique // "attendance", "payroll", "reports"
  displayName String // "Attendance", "Payroll", "Reports"
  icon        String // ui icon
  url         String // "/attendance"
  parentId    Int? // Submenu ke liye
  order       Int     @default(0)
  isActive    Boolean @default(true)

  parent   Module?  @relation("SubModules", fields: [parentId], references: [id])
  children Module[] @relation("SubModules")

  permission Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//Permissions Table — Role + Module ka combination
model Permission {
  id Int @id @default(autoincrement())

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Access levels
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, moduleId, companyId]) // Ek role ka ek module pe ek hi permission
}

model Branch {
  id           String  @id @default(uuid())
  name         String
  code         String
  address      String?
  phone        String?
  email        String?
  city         String?
  state        String?
  pincode      String?
  managerName  String?
  latitude     Float? // 28.6139
  longitude    Float? // 77.2090
  geoRadius    Float? // 100 (meters)
  locationName String?
  isActive     Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  categories  Category[]
  users       User[]
  attendances Attendance[]

  @@unique([code, companyId])
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String
  isActive    Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@unique([name, branchId])
}

model Attendance {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  date DateTime // Sirf date (00:00:00 time) — ek din ka unique record

  punchInTime  DateTime?
  punchOutTime DateTime?

  punchInLat  Float?
  punchInLng  Float?
  punchOutLat Float?
  punchOutLng Float?

  isWithinGeoFence Boolean @default(true)

  status String @default("Present") // Present / Absent / Half-day / Late

  workingHours Float? // Auto calculate (punch out - punch in)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Ek user ka ek din ka ek hi record
}

model CompanySettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  lateMarkHour     Int   @default(10)
  lateMarkMinute   Int   @default(15)
  halfDayHours     Float @default(4)
  defaultGeoRadius Float @default(100)

  weekOffDays Int[] @default([0]) // 0 = Sunday, 6 = Saturday

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id          String  @id @default(uuid())
  name        String // "Sick Leave", "Casual Leave", "Earned Leave"
  description String?
  daysPerYear Int     @default(12)
  isActive    Boolean @default(true)
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])

  leaveRequest LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation("LeaveRequests", fields: [userId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  startDate DateTime
  endDate   DateTime
  totalDays Float
  reason    String?

  status String @default("Pending") // Pending/Approved/Rejected

  approvedBy     String?
  approvedByUser User?   @relation("ApprovedLeaves", fields: [approvedBy], references: [id])

  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
